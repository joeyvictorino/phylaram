<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Import WDK and SDK NuGet package targets for CI builds.
    These are restored by 'nuget restore packages.config -PackagesDirectory packages'
    following the microsoft/Windows-driver-samples pattern.
  -->
  <Import Project="$(MSBuildThisFileDirectory)packages\Microsoft.Windows.WDK.x64.10.0.26100.1\build\native\Microsoft.Windows.WDK.x64.props"
          Condition="Exists('$(MSBuildThisFileDirectory)packages\Microsoft.Windows.WDK.x64.10.0.26100.1\build\native\Microsoft.Windows.WDK.x64.props')" />
  <Import Project="$(MSBuildThisFileDirectory)packages\Microsoft.Windows.SDK.CPP.10.0.26100.1\build\native\Microsoft.Windows.SDK.CPP.props"
          Condition="Exists('$(MSBuildThisFileDirectory)packages\Microsoft.Windows.SDK.CPP.10.0.26100.1\build\native\Microsoft.Windows.SDK.CPP.props')" />
</Project>
